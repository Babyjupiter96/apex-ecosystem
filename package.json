{
  "name": "apex-ecosystem",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "dev:agency": "turbo dev --filter=agency",
    "dev:pt": "turbo dev --filter=pt",
    "dev:admin": "turbo dev --filter=admin",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "turbo db:generate --filter=@apex/db",
    "db:migrate": "turbo db:migrate --filter=@apex/db",
    "db:migrate:dev": "turbo db:migrate:dev --filter=@apex/db",
    "db:studio": "pnpm --filter=@apex/db studio",
    "db:seed": "pnpm --filter=@apex/db seed",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.5.0"
  }
}
